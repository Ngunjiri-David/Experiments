<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Noonmark Ledger</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Instrument+Serif&display=swap">
<style>
/* Layout concept: a ruled ledger sheet. One masthead, then hairline-ruled sections that each carry a data-status tag.
   Brass marks are project data. Grey hatched marks and rows are sample data. Record panels share one filter row. */
:root{
  --ground:#F4F3EF; --surface:#FFFFFF; --sunken:#EEEDE8;
  --ink:#17191C; --ink-2:#4A4D52; --muted:#62666C;
  --rule:#E3E1DA; --rule-2:#CFCCC2;
  --brass:#B08A45; --brass-text:#886844; --brass-wash:rgba(176,138,69,.12);
  --sample:#5E6A78; --sample-mark:#7C8896; --hatch:rgba(94,106,120,.16);
  --fail:#B33A3A;
  --shadow:rgba(23,25,28,.22);
  --ease:cubic-bezier(.2,.7,.2,1); --dur:180ms;
  --f-display:"Instrument Serif","Iowan Old Style",Georgia,serif;
  --f-ui:"Hanken Grotesk",system-ui,-apple-system,"Segoe UI",sans-serif;
  --f-mono:"IBM Plex Mono",ui-monospace,"SFMono-Regular",Menlo,monospace;
  color-scheme:light;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --ground:#121417; --surface:#1A1D21; --sunken:#202429;
    --ink:#ECEAE4; --ink-2:#B9B7B0; --muted:#8E9399;
    --rule:#272A2E; --rule-2:#353A3F;
    --brass:#C9A25E; --brass-text:#D6B36F; --brass-wash:rgba(201,162,94,.14);
    --sample:#A3AEBB; --sample-mark:#6D7783; --hatch:rgba(163,174,187,.16);
    --fail:#E26A6A; --shadow:rgba(0,0,0,.55);
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --ground:#121417; --surface:#1A1D21; --sunken:#202429;
  --ink:#ECEAE4; --ink-2:#B9B7B0; --muted:#8E9399;
  --rule:#272A2E; --rule-2:#353A3F;
  --brass:#C9A25E; --brass-text:#D6B36F; --brass-wash:rgba(201,162,94,.14);
  --sample:#A3AEBB; --sample-mark:#6D7783; --hatch:rgba(163,174,187,.16);
  --fail:#E26A6A; --shadow:rgba(0,0,0,.55);
  color-scheme:dark;
}

*{box-sizing:border-box}
[hidden]{display:none!important}
html{scrollbar-color:var(--rule-2) transparent;scroll-behavior:smooth}
body{margin:0;background:var(--ground);color:var(--ink);font:14px/1.55 var(--f-ui);-webkit-font-smoothing:antialiased}
::selection{background:var(--brass-wash);color:var(--ink)}
::-webkit-scrollbar{height:10px;width:10px}
::-webkit-scrollbar-thumb{background:var(--rule-2);border-radius:99px;border:2px solid transparent;background-clip:padding-box}
:focus-visible{outline:2px solid var(--ink);outline-offset:2px;border-radius:2px}
a{color:var(--brass-text);text-underline-offset:3px}
h1,h2,h3,p{margin:0}
button,input,select{font:inherit;color:inherit}
.wrap{max-width:1240px;margin:0 auto;padding-block:32px 64px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.mono{font-family:var(--f-mono)}
.eyebrow{font:500 11px/1.4 var(--f-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--brass-text)}
.hint{color:var(--muted);font-size:12.5px}

/* masthead */
.mast{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:24px 48px;align-items:end;padding-bottom:26px;border-bottom:1px solid var(--ink)}
.mast h1{font:400 clamp(44px,7vw,76px)/.98 var(--f-display);letter-spacing:-.01em;margin:10px 0 14px;text-wrap:balance}
.mast .sub{font-size:18px;line-height:1.45;color:var(--ink-2);max-width:46ch}
.mast dl{margin:0;display:grid;grid-template-columns:auto auto;gap:6px 18px;font:400 12px/1.4 var(--f-mono);color:var(--ink-2)}
.mast dt{color:var(--muted);text-transform:uppercase;letter-spacing:.08em;font-size:10.5px;align-self:center}
.mast dd{margin:0}
.nav{display:flex;flex-wrap:wrap;gap:4px 22px;padding:12px 0;border-bottom:1px solid var(--rule-2);font-size:13px}
.nav a{color:var(--ink-2);text-decoration:none;padding:4px 0;border-bottom:1px solid transparent;transition:color var(--dur) var(--ease),border-color var(--dur) var(--ease)}
.nav a:hover{color:var(--brass-text);border-color:var(--brass)}

/* about + status */
.about{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:28px 56px;margin-top:30px}
.about p{max-width:62ch;color:var(--ink-2);font-size:15px;line-height:1.6}
.about p+p{margin-top:12px}
.status{border:1px solid var(--rule-2);background:var(--surface);border-radius:4px;padding:16px 18px;align-self:start}
.status h2{font:500 11px/1.4 var(--f-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--ink);margin-bottom:8px}
.status p{font-size:13px;line-height:1.55;color:var(--ink-2)}
.legend{display:flex;flex-wrap:wrap;gap:8px 16px;margin-top:12px;padding-top:12px;border-top:1px solid var(--rule);font-size:12.5px;color:var(--ink-2)}
.legend span{display:inline-flex;align-items:center;gap:8px}
.sw{width:22px;height:10px;border-radius:0 3px 3px 0;background:var(--brass)}
.sw.sample{background:var(--sample-mark) repeating-linear-gradient(135deg,rgba(255,255,255,.3) 0 2px,transparent 2px 6px)}

/* sections */
.sheet{margin-top:60px;scroll-margin-top:16px}
.sheet-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:end;gap:10px 20px;border-bottom:1px solid var(--rule-2);padding-bottom:10px;margin-bottom:18px}
.sheet-head h2{font:400 clamp(28px,4vw,38px)/1.1 var(--f-display);letter-spacing:-.005em}
.sheet-head p{color:var(--ink-2);max-width:60ch;margin-top:6px;font-size:14px}
.tag{display:inline-block;font:500 10.5px/1 var(--f-mono);letter-spacing:.07em;text-transform:uppercase;padding:4px 8px;border-radius:99px;border:1px solid;white-space:nowrap}
.tag.project{color:var(--brass-text);border-color:color-mix(in srgb,var(--brass) 55%,transparent)}
.tag.sample{color:var(--sample);border-color:color-mix(in srgb,var(--sample-mark) 55%,transparent);background:repeating-linear-gradient(135deg,var(--hatch) 0 1px,transparent 1px 5px)}

/* key figures */
.tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:1px;background:var(--rule-2);border:1px solid var(--rule-2);border-radius:4px;overflow:hidden}
.tile{background:var(--surface);padding:20px 22px 18px;display:flex;flex-direction:column;gap:2px}
.tile .k{color:var(--ink-2);font-size:13px}
.tile .v{font-size:46px;font-weight:600;line-height:1.1;letter-spacing:-.02em;color:var(--ink)}
.tile .s{color:var(--muted);font-size:12.5px;margin-top:2px}
.tile .src{margin-top:12px;font:400 10.5px/1.3 var(--f-mono);letter-spacing:.06em;text-transform:uppercase;color:var(--brass-text)}

/* panels, grid */
.grid{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));gap:18px}
.panel{background:var(--surface);border:1px solid var(--rule);border-radius:4px;padding:20px 22px;min-width:0}
.panel h3{font:600 15px/1.35 var(--f-ui);margin-bottom:2px}
.panel .csub{color:var(--muted);font-size:12.5px;margin-bottom:14px}
.c7{grid-column:span 7}.c5{grid-column:span 5}.c6{grid-column:span 6}.c12{grid-column:span 12}

/* bar charts */
.chart{position:relative;--lw:200px}
.plot{position:relative;padding-top:22px}
.gridlayer{position:absolute;inset:0 0 0 var(--lw);pointer-events:none}
.gl{position:absolute;top:22px;bottom:0;width:1px;background:var(--rule)}
.floor{position:absolute;top:18px;bottom:0;width:2px;margin-left:-1px;background:var(--ink-2)}
.floor-label{position:absolute;top:0;transform:translateX(-50%);font:500 10.5px/1.2 var(--f-mono);letter-spacing:.05em;color:var(--ink);white-space:nowrap;background:var(--surface);padding:0 4px}
.brow{position:relative;z-index:1;display:grid;grid-template-columns:var(--lw) minmax(0,1fr);align-items:center;min-height:42px;border-radius:2px}
.brow:hover .bar{filter:brightness(1.1)}
.blabel{padding-right:12px;line-height:1.3;background:var(--surface);position:relative}
.blabel b{display:block;font-weight:500;font-size:13px;color:var(--ink)}
.bsub{display:inline-flex;align-items:center;gap:5px;font-size:11.5px;color:var(--muted)}
.bsub .ic{display:inline-flex}
.btrack{position:relative;height:42px}
.bar{position:absolute;left:0;top:50%;height:18px;margin-top:-9px;border-radius:0 4px 4px 0;background:var(--brass);transition:width var(--dur) var(--ease)}
.bar.fail{background:var(--fail)}
.bar.sample{background:var(--sample-mark) repeating-linear-gradient(135deg,rgba(255,255,255,.32) 0 2px,transparent 2px 6px)}
.bval{position:absolute;top:50%;transform:translateY(-50%);margin-left:4px;padding:0 4px;background:var(--surface);font-size:13px;font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap}
.axis{position:relative;height:22px;margin-left:var(--lw);border-top:1px solid var(--rule-2)}
.axis span{position:absolute;top:4px;transform:translateX(-50%);font:400 11px/1 var(--f-mono);color:var(--muted)}
.axis span:first-child{transform:none}
details.twin{margin-top:14px;border-top:1px solid var(--rule);padding-top:10px}
details.twin summary{cursor:pointer;font-size:12.5px;color:var(--brass-text);width:max-content}
details.twin table{margin-top:10px;min-width:0}

/* contrast checker */
.checker{display:grid;gap:14px}
.pair{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.field label{display:block;font:500 10.5px/1.3 var(--f-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:5px}
.field .in{display:flex;border:1px solid var(--rule-2);border-radius:3px;background:var(--surface);overflow:hidden}
.field input[type=color]{width:38px;height:36px;border:0;padding:3px;background:transparent;cursor:pointer;flex:none}
.field input[type=text]{width:100%;min-width:0;border:0;border-left:1px solid var(--rule);padding:0 10px;font:400 13px var(--f-mono);background:transparent;text-transform:uppercase}
.field .in:focus-within{outline:2px solid var(--ink);outline-offset:1px}
.field input:focus-visible{outline:none}
.readout{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap}
.readout .big{font-size:46px;font-weight:600;letter-spacing:-.02em;line-height:1.05}
.verdicts{display:grid;gap:6px}
.verdict{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--ink-2)}
.verdict .ic{display:inline-flex;color:var(--brass-text)}
.verdict.no .ic{color:var(--fail)}
.preview{border:1px solid var(--rule-2);border-radius:3px;padding:16px 18px;font-size:16px;line-height:1.4;min-height:56px;display:flex;align-items:center}
.presets{display:flex;flex-wrap:wrap;gap:8px}
.chip{border:1px solid var(--rule-2);background:var(--surface);border-radius:3px;padding:6px 10px;font-size:12.5px;cursor:pointer;transition:border-color var(--dur) var(--ease),background var(--dur) var(--ease)}
.chip:hover{border-color:var(--brass)}

/* filter row */
.filters{display:flex;flex-wrap:wrap;gap:10px 14px;align-items:center;padding:14px 0;border-block:1px solid var(--rule-2);margin-top:60px;scroll-margin-top:16px}
.filters .lead{font:500 11px/1 var(--f-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--muted)}
.search{position:relative}
.search input{width:250px;max-width:100%;height:36px;border:1px solid var(--rule-2);border-radius:3px;padding:0 12px;background:var(--surface)}
.seg{display:inline-flex;border:1px solid var(--rule-2);border-radius:3px;overflow:hidden;background:var(--surface)}
.seg button{border:0;background:transparent;padding:0 13px;height:34px;cursor:pointer;font-size:13px;color:var(--ink-2);transition:background var(--dur) var(--ease),color var(--dur) var(--ease)}
.seg button+button{border-left:1px solid var(--rule)}
.seg button:hover{background:var(--sunken)}
.seg button[aria-pressed="true"]{background:color-mix(in srgb,var(--brass) 10%,var(--surface));color:var(--brass-text);font-weight:600}
select{height:36px;border:1px solid var(--rule-2);border-radius:3px;padding:0 10px;background:var(--surface);cursor:pointer}
.reset{border:0;background:none;color:var(--brass-text);cursor:pointer;padding:6px 2px;font-size:13px;text-decoration:underline;text-underline-offset:3px}
.count{margin-left:auto;font:400 12px/1.3 var(--f-mono);color:var(--ink-2)}

/* tables */
.tscroll{overflow-x:auto;border:1px solid var(--rule);border-radius:4px;background:var(--surface)}
table{border-collapse:collapse;width:100%;min-width:720px}
th{font:500 10.5px/1.3 var(--f-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted);text-align:left;padding:10px 14px;background:var(--sunken);white-space:nowrap}
td{padding:11px 14px;border-top:1px solid var(--rule);vertical-align:baseline}
#fbTbl{min-width:560px}
td.num{font-variant-numeric:tabular-nums;white-space:nowrap}
tr.is-sample td{background-image:repeating-linear-gradient(135deg,var(--hatch) 0 1px,transparent 1px 8px)}
tr.clickable{cursor:pointer}
tr.clickable:hover td{background-color:color-mix(in srgb,var(--brass) 7%,transparent)}
.area{font:400 11.5px/1.3 var(--f-mono);color:var(--ink-2);white-space:nowrap}
.val{font-weight:600}
.rowbtn{all:unset;cursor:pointer;color:var(--ink);font-weight:500;border-bottom:1px solid var(--rule-2)}
.rowbtn:hover{color:var(--brass-text);border-color:var(--brass)}
.rowbtn:focus-visible{outline:2px solid var(--ink);outline-offset:2px}
.empty{padding:26px 22px;color:var(--ink-2);max-width:60ch}
.empty b{display:block;font:400 22px/1.2 var(--f-display);color:var(--ink);margin-bottom:4px}

/* drawer */
#veil{position:fixed;inset:0;background:var(--shadow);z-index:40;opacity:0;transition:opacity var(--dur) var(--ease)}
#veil.open{opacity:1}
#drawer{position:fixed;top:0;right:0;bottom:0;width:min(540px,100vw);background:var(--surface);z-index:41;border-left:1px solid var(--rule-2);overflow:auto;transform:translateX(100%);transition:transform var(--dur) var(--ease);padding-bottom:env(safe-area-inset-bottom,0px)}
#drawer.open{transform:none}
.dhead{display:flex;justify-content:space-between;gap:16px;align-items:start;padding:22px 24px 16px;border-bottom:1px solid var(--rule-2);position:sticky;top:0;background:var(--surface)}
.dhead h3{font:400 28px/1.15 var(--f-display);margin-top:6px}
.dclose{border:1px solid var(--rule-2);background:var(--surface);width:40px;height:40px;border-radius:3px;cursor:pointer;font-size:16px;flex:none}
.dclose:hover{border-color:var(--brass)}
.dbody{padding:8px 24px 28px}
.dbody .note{margin:14px 0 0;padding:10px 12px;border:1px solid color-mix(in srgb,var(--sample-mark) 50%,transparent);background:repeating-linear-gradient(135deg,var(--hatch) 0 1px,transparent 1px 7px);font-size:13px;color:var(--ink-2);border-radius:3px}
.dsec{padding:16px 0;border-bottom:1px solid var(--rule)}
.dsec:last-child{border-bottom:0}
.dsec h4{margin:0 0 6px;font:500 10.5px/1.3 var(--f-mono);letter-spacing:.1em;text-transform:uppercase;color:var(--brass-text)}
.dsec p{font-size:14.5px;line-height:1.6;color:var(--ink)}
.dsrc{margin-top:16px;font:400 11.5px/1.5 var(--f-mono);color:var(--muted)}

/* tooltip */
#tip{position:fixed;z-index:60;pointer-events:none;background:var(--ink);color:var(--ground);padding:8px 11px;border-radius:3px;font-size:12.5px;line-height:1.4;max-width:260px;box-shadow:0 6px 20px var(--shadow)}
#tip .tv{font-size:15px;font-weight:600}
#tip .tl{opacity:.85}

footer{margin-top:64px;padding-top:20px;border-top:1px solid var(--ink);display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:20px 56px;color:var(--ink-2);font-size:13px}
footer p{max-width:64ch}
footer details summary{cursor:pointer;color:var(--brass-text)}
footer code{font:400 12px var(--f-mono);background:var(--sunken);padding:1px 5px;border-radius:2px}

@media (max-width:900px){
  .c7,.c5,.c6{grid-column:span 12}
  .about,footer{grid-template-columns:minmax(0,1fr)}
  .mast{grid-template-columns:minmax(0,1fr)}
}
@media (max-width:560px){
  /* phone: label sits above its bar; the label band masks the gridlines behind it */
  .chart{--lw:0px!important}
  .brow{grid-template-columns:minmax(0,1fr)}
  .blabel{padding:8px 0 0}
  .btrack{height:30px}
  .pair{grid-template-columns:1fr}
  .count{margin-left:0;width:100%}
  .tile .v{font-size:40px}
  .panel{padding:16px}
}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{transition:none!important;animation:none!important;scroll-behavior:auto!important}
}
</style>
</head>
<body>


<div class="wrap">

<header class="mast">
  <div>
    <div class="eyebrow">Sovereign Atelier · Noonmark 0.2.1 · Android</div>
    <h1>Noonmark Ledger</h1>
    <p class="sub">Release gates, tests, decisions and alpha feedback for a task list that keeps every task on the phone.</p>
  </div>
  <dl>
    <dt>Maintainer</dt><dd>David Ngunjiri</dd>
    <dt>Data as of</dt><dd>5 Nov 2026</dd>
    <dt>Stack</dt><dd>Flutter · Dart · SQLite</dd>
    <dt>Release build</dt><dd>0 requests · 0 permissions</dd>
  </dl>
</header>

<nav class="nav" aria-label="Sections">
  <a href="#figures">Key figures</a>
  <a href="#contrast">Contrast floor</a>
  <a href="#records">Filters</a>
  <a href="#gates">Release gates</a>
  <a href="#tests">Test suite</a>
  <a href="#decisions">Decision log</a>
  <a href="#alpha">Alpha ledger</a>
</nav>

<section class="about" aria-labelledby="aboutT">
  <div>
    <h2 class="eyebrow" id="aboutT" style="margin-bottom:10px">About this ledger</h2>
    <p>Noonmark sorts tasks into Overdue, Today, Upcoming and Anytime, stores them in a private database on the phone, and asks Android for nothing. This ledger gathers the quality record behind that: the release gates the app is held to, the automated tests, the written decisions, and feedback from the closed-testing alpha.</p>
    <p>Use the filters to narrow the record panels by area, by search term, or by data status. The decision log opens each entry in full, with the alternatives that were rejected and the condition that would reverse it.</p>
  </div>
  <aside class="status" aria-labelledby="statusT">
    <h2 id="statusT">Status of the figures</h2>
    <p id="statusText"></p>
    <div class="legend">
      <span><i class="sw"></i>Project data</span>
      <span><i class="sw sample"></i>Sample data</span>
    </div>
  </aside>
</section>

<section class="sheet" id="figures" aria-labelledby="figT">
  <div class="sheet-head">
    <div><h2 id="figT">Key figures</h2><p>Four numbers the release build is held to.</p></div>
    <span class="tag project">Project data</span>
  </div>
  <div class="tiles">
    <div class="tile"><span class="k">Automated tests</span><span class="v">15</span><span class="s">task-day sorting, backup-file checks, accent contrast</span><span class="src">Product page</span></div>
    <div class="tile"><span class="k">Libraries</span><span class="v">3</span><span class="s">a new one needs a written decision first; 3 unused removed</span><span class="src">Product page</span></div>
    <div class="tile"><span class="k">Android permissions</span><span class="v">0</span><span class="s">none requested by the release build</span><span class="src">Product page</span></div>
    <div class="tile"><span class="k">Network requests</span><span class="v">0</span><span class="s">none in the release build, no sign-in, no server</span><span class="src">Product page</span></div>
  </div>
</section>

<section class="sheet" id="contrast" aria-labelledby="conT">
  <div class="sheet-head">
    <div><h2 id="conT">Contrast floor</h2><p>Accent text has to reach 4.5:1 against its ground in light and in dark, and a test fails if it does not.</p></div>
    <span class="tag project">Project data</span>
  </div>
  <div class="grid">
    <div class="panel c7">
      <h3>Accent text before and after the 29 Oct 2026 decision</h3>
      <p class="csub">Contrast ratio, from the decision log. The line marks the 4.5:1 floor.</p>
      <div id="contrastChart"></div>
    </div>
    <div class="panel c5">
      <h3>Check a pair of colours</h3>
      <p class="csub">The same WCAG 2 ratio, computed here in the page.</p>
      <div class="checker">
        <div class="pair">
          <div class="field"><label for="fgHex">Text</label><div class="in"><input type="color" id="fgPick" value="#886844" aria-label="Pick text colour"><input type="text" id="fgHex" value="#886844" maxlength="7" spellcheck="false" autocomplete="off"></div></div>
          <div class="field"><label for="bgHex">Ground</label><div class="in"><input type="color" id="bgPick" value="#ffffff" aria-label="Pick ground colour"><input type="text" id="bgHex" value="#FFFFFF" maxlength="7" spellcheck="false" autocomplete="off"></div></div>
        </div>
