const STATES = ['New','Triaged','Fixed','Declined'];

/* ---------- Helpers ---------- */
const $ = (s,r)=> (r||document).querySelector(s);
function h(tag, props){
  const n=document.createElement(tag);
  if(props) for(const k in props){
    if(k==='class') n.className=props[k];
    else if(k==='text') n.textContent=props[k];
    else n.setAttribute(k,props[k]);
  }
  for(let i=2;i<arguments.length;i++){
    const c=arguments[i];
    if(c==null||c===false) continue;
    n.append(c.nodeType?c:document.createTextNode(String(c)));
  }
  return n;
}
const ICON={
  ok:'<svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path d="M3 8.5l3.2 3L13 4.8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  no:'<svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>'
};
function icon(k){ const s=h('span',{class:'ic'}); s.innerHTML=ICON[k]; return s; }
function tag(data){ return h('span',{class:'tag '+data, text: data==='project'?'Project':'Sample'}); }
function norm(s){ return String(s||'').toLowerCase(); }

/* ---------- Tooltip (value leads, label follows) ---------- */
const tip=$('#tip');
function showTip(anchor, value, label, ev){
  tip.querySelector('.tv').textContent=value;
  tip.querySelector('.tl').textContent=label;
  tip.hidden=false;
  const r=tip.getBoundingClientRect();
  let x,y;
  if(ev && ev.clientX!=null && ev.type!=='focus'){ x=ev.clientX+14; y=ev.clientY+16; }
  else { const a=anchor.getBoundingClientRect(); x=a.left+Math.min(a.width,260)/2; y=a.bottom+6; }
  x=Math.max(8,Math.min(x,window.innerWidth-r.width-8));
  if(y+r.height>window.innerHeight-8) y=Math.max(8,y-r.height-34);
  tip.style.left=x+'px'; tip.style.top=y+'px';
}
function hideTip(){ tip.hidden=true; }

/* ---------- Bar chart: div bars on one scale, value at the tip, table twin ---------- */
function barChart(host, o){
  host.replaceChildren();
  const chart=h('div',{class:'chart',style:'--lw:'+(o.lw||'210px')});
  const plot=h('div',{class:'plot'});
  const grid=h('div',{class:'gridlayer','aria-hidden':'true'});
  o.ticks.forEach(t=>grid.append(h('i',{class:'gl',style:'left:'+(t/o.max*100)+'%'})));
  if(o.floor!=null){
    grid.append(h('i',{class:'floor',style:'left:'+(o.floor/o.max*100)+'%'}));
    grid.append(h('span',{class:'floor-label',style:'left:'+(o.floor/o.max*100)+'%',text:o.floorLabel}));
  }
  plot.append(grid);
  o.rows.forEach(r=>{
    const pct=r.value/o.max*100;
    const label=h('div',{class:'blabel'}, h('b',{text:r.label}));
    if(r.sub){
      const sub=h('span',{class:'bsub'});
      if(r.status) sub.append(icon(r.status==='ok'?'ok':'no'));
      sub.append(document.createTextNode(r.sub));
      label.append(sub);
    }
    const track=h('div',{class:'btrack'},
      h('div',{class:'bar '+(r.mark||''),style:'width:'+pct+'%'}),
      h('span',{class:'bval',style:'left:'+pct+'%',text:r.valueText}));
    const row=h('div',{class:'brow',tabindex:'0',role:'group','aria-label':r.label+', '+r.valueText+(r.sub?', '+r.sub:'')}, label, track);
    const move=e=>showTip(row,r.valueText,r.tip,e);
    row.addEventListener('pointermove',move);
    row.addEventListener('pointerleave',hideTip);
    row.addEventListener('focus',e=>showTip(row,r.valueText,r.tip,e));
    row.addEventListener('blur',hideTip);
    plot.append(row);
  });
  chart.append(plot);
  const axis=h('div',{class:'axis','aria-hidden':'true'});
  o.ticks.forEach(t=>axis.append(h('span',{style:'left:'+(t/o.max*100)+'%',text:String(t)})));
  chart.append(axis);
  host.append(chart);
  // table twin: every value reachable without hovering
  const tbl=h('table',null,
    h('thead',null,h('tr',null,...o.twinHead.map(t=>h('th',{text:t})))),
    h('tbody',null,...o.rows.map(r=>h('tr',null,...r.twin.map((c,i)=>h('td',{text:c,class:i===1?'num':''}))))));
  host.append(h('details',{class:'twin'},h('summary',{text:'Table view'}),h('div',{class:'tscroll'},tbl)));
}

/* ---------- Contrast (WCAG 2) ---------- */
function parseHex(s){
  s=String(s).trim().replace(/^#/,'');
  if(/^[0-9a-f]{3}$/i.test(s)) s=s.split('').map(c=>c+c).join('');
  return /^[0-9a-f]{6}$/i.test(s)?s.toUpperCase():null;
}
function lum(hex){
  const ch=i=>{ const c=parseInt(hex.slice(i,i+2),16)/255; return c<=0.03928?c/12.92:Math.pow((c+0.055)/1.055,2.4); };
  return 0.2126*ch(0)+0.7152*ch(2)+0.0722*ch(4);
}
function ratio(a,b){ const x=lum(a),y=lum(b); return (Math.max(x,y)+0.05)/(Math.min(x,y)+0.05); }

function renderContrastChart(){
  barChart($('#contrastChart'),{
    max:7, ticks:[0,1,2,3,4,5,6,7], floor:4.5, floorLabel:'4.5 floor', lw:'200px',
    twinHead:['Pair','Ratio','Status'],
    rows:DATA.contrast.map(c=>({
      label:c.label, sub:c.sub+(c.pass?' · clears the floor':' · below the floor'), status:c.pass?'ok':'no',
      value:c.value, valueText:c.value.toFixed(2)+':1', mark:c.pass?'':'fail',
      tip:c.note, twin:[c.label+' ('+c.sub.toLowerCase()+')', c.value.toFixed(2)+':1', c.pass?'Clears 4.5:1':'Below 4.5:1']
    }))
  });
}

function wireChecker(){
  const fgP=$('#fgPick'), fgH=$('#fgHex'), bgP=$('#bgPick'), bgH=$('#bgHex');
  const out=$('#ratio'), ver=$('#verdicts'), pre=$('#preview');
  function update(){
    const fg=parseHex(fgH.value), bg=parseHex(bgH.value);
    ver.replaceChildren();
    if(!fg||!bg){
      out.textContent='Not a colour';
      ver.append(h('div',{class:'verdict no'},icon('no'),'Enter a three or six digit hex value, such as 886844.'));
      return;
    }
    const r=ratio(fg,bg);
    out.textContent=r.toFixed(2)+':1';
    const rows=[[4.5,'Body text, 4.5:1'],[3,'Large text and icons, 3:1']];
    rows.forEach(([min,txt])=>{
      const ok=r>=min;
      ver.append(h('div',{class:'verdict '+(ok?'ok':'no')},icon(ok?'ok':'no'),(ok?'Clears ':'Misses ')+txt));
    });
    pre.style.color='#'+fg; pre.style.background='#'+bg;
  }
  function setPair(fg,bg){
    fgH.value=fg.toUpperCase(); bgH.value=bg.toUpperCase();
    const a=parseHex(fg), b=parseHex(bg);
    if(a) fgP.value='#'+a.toLowerCase(); if(b) bgP.value='#'+b.toLowerCase();
    update();
  }
  fgP.addEventListener('input',()=>{ fgH.value=fgP.value.toUpperCase(); update(); });
  bgP.addEventListener('input',()=>{ bgH.value=bgP.value.toUpperCase(); update(); });
  fgH.addEventListener('input',()=>{ const v=parseHex(fgH.value); if(v) fgP.value='#'+v.toLowerCase(); update(); });
  bgH.addEventListener('input',()=>{ const v=parseHex(bgH.value); if(v) bgP.value='#'+v.toLowerCase(); update(); });
  document.querySelectorAll('.chip[data-fg]').forEach(b=>b.addEventListener('click',()=>setPair(b.dataset.fg,b.dataset.bg)));
  update();
}

/* ---------- Filters ---------- */
const state={q:'',data:'all',area:'all'};
function visible(rec, text){
  if(state.data!=='all' && rec.data!==state.data) return false;
  if(state.area!=='all' && rec.area!==state.area) return false;
  if(state.q && norm(text).indexOf(state.q)<0) return false;
  return true;
}
const tally={};
function empty(msgHead,msgBody){ return h('div',{class:'empty'},h('b',{text:msgHead}),msgBody); }
function fillBody(tbl, rows, cols, emptyEl){
  const body=tbl.querySelector('tbody'); body.replaceChildren();
  const wrap=tbl.parentElement;
  const old=wrap.querySelector('.empty'); if(old) old.remove();
  tbl.hidden = rows.length===0;
  if(!rows.length){ wrap.append(emptyEl); return; }
  rows.forEach(r=>body.append(cols(r)));
}

function renderGates(){
  const all=DATA.gates;
  const rows=all.filter(g=>visible(g,[g.area,g.gate,g.measure,g.basis].join(' ')));
  tally.gates=[rows.length,all.length];
  fillBody($('#gateTbl'),rows,g=>h('tr',{class:g.data==='sample'?'is-sample':''},
    h('td',null,h('span',{class:'area',text:g.area})),
    h('td',{class:'val',text:g.gate}),
    h('td',{text:g.measure}),
    h('td',{class:'area',text:g.basis})),
    empty('No gates match.','The release build is held to a short list. Widen the filter to see all of it.'));
}

function renderTests(){
  const host=$('#testChart');
  const all=DATA.tests;
  const rows=all.filter(t=>visible(t,[t.area,t.label,'tests sample'].join(' ')));
  tally.tests=[rows.length,all.length];
  if(!rows.length){ host.replaceChildren(empty('No test rows match.','The suite totals 15 tests. The split by area appears when sample data is in view.')); return; }
  barChart(host,{
    max:8, ticks:[0,2,4,6,8], lw:'210px',
    twinHead:['Area','Tests','Data'],
    rows:rows.map(t=>({label:t.label, sub:'Sample split', value:t.count, valueText:String(t.count), mark:'sample',
      tip:t.area+'. Sample split of the 15 tests.', twin:[t.label, String(t.count), 'Sample']}))
  });
}

function renderDecisions(){
  const all=DATA.decisions;
  const rows=all.filter(d=>visible(d,[d.ref,d.title,d.area,d.decision,d.reason,d.rejected,d.reversal].join(' ')));
  tally.decisions=[rows.length,all.length];
  fillBody($('#decTbl'),rows,d=>{
    const tr=h('tr',{class:'clickable'+(d.data==='sample'?' is-sample':'')},
      h('td',{class:'area',text:d.ref}),
      h('td',{class:'num',text:d.date||'—'}),
      h('td',null,h('span',{class:'area',text:d.area})),
      h('td',null,(function(){ const b=h('button',{class:'rowbtn',type:'button',text:d.title}); b.addEventListener('click',e=>{e.stopPropagation();openDrawer(d,b);}); return b; })()),
      h('td',null,tag(d.data)));
    tr.addEventListener('click',()=>openDrawer(d,tr.querySelector('.rowbtn')));
    return tr;
  }, empty('No decisions match.','The log keeps each choice, the alternatives rejected and the condition that would reverse it. Widen the filter to read them.'));
}

function renderFeedback(){
  const all=DATA.feedback;
  const rows=all.filter(f=>visible(f,[f.ref,f.type,f.area,f.summary,f.state].join(' ')));
  tally.feedback=[rows.length,all.length];
  fillBody($('#fbTbl'),rows,f=>h('tr',{class:f.data==='sample'?'is-sample':''},
    h('td',{class:'area',text:f.ref}),
    h('td',{text:f.type}),
    h('td',null,h('span',{class:'area',text:f.area})),
    h('td',{text:f.summary}),
    h('td',null,h('span',{class:'val',text:f.state}))),
    empty('No feedback matches.','Alpha notes land here after triage. Widen the filter to see them.'));
  const host=$('#fbChart');
  if(!rows.length){ host.replaceChildren(empty('Nothing to count.','No feedback in view.')); return; }
  const counts=STATES.map(s=>({s,n:rows.filter(r=>r.state===s).length}));
  barChart(host,{
    max:4, ticks:[0,1,2,3,4], lw:'120px',
    twinHead:['State','Items','Data'],
    rows:counts.map(c=>({label:c.s, value:c.n, valueText:String(c.n), mark:'sample',
      tip:'Sample feedback items in this state.', twin:[c.s,String(c.n),'Sample']}))
  });
}

function renderCount(){
  let shown=0,total=0;
  Object.keys(tally).forEach(k=>{ shown+=tally[k][0]; total+=tally[k][1]; });
  $('#count').textContent='Showing '+shown+' of '+total+' rows';
}
function renderStatus(){
  const rows=[].concat(DATA.gates,DATA.tests,DATA.decisions,DATA.feedback);
  const p=rows.filter(r=>r.data==='project').length, s=rows.length-p;
  $('#statusText').textContent=p+' rows are project data and '+s+' are sample. Project data comes from the published Noonmark page and the maintainer’s résumé. Sample rows show how each panel reads once the project’s own test list, decision log and alpha ledger are loaded. Nothing here is a commitment beyond what the product page states.';
}
function renderAll(){ renderGates(); renderTests(); renderDecisions(); renderFeedback(); renderCount(); }

function wireFilters(){
  const sel=$('#area');
  DATA.areas.forEach(a=>sel.append(h('option',{value:a,text:a})));
  $('#q').addEventListener('input',e=>{ state.q=norm(e.target.value).trim(); renderAll(); });
  sel.addEventListener('change',e=>{ state.area=e.target.value; renderAll(); });
  const seg=$('#dataSeg');
  seg.addEventListener('click',e=>{
    const b=e.target.closest('button'); if(!b) return;
    state.data=b.dataset.v;
    seg.querySelectorAll('button').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));
    renderAll();
  });
  $('#reset').addEventListener('click',()=>{
    state.q='';state.data='all';state.area='all';
    $('#q').value=''; sel.value='all';
    seg.querySelectorAll('button').forEach(x=>x.setAttribute('aria-pressed',String(x.dataset.v==='all')));
    renderAll();
  });
}

/* ---------- Drawer ---------- */
const drawer=$('#drawer'), veil=$('#veil');
let lastFocus=null;
function section(head,text){ return text?h('div',{class:'dsec'},h('h4',{text:head}),h('p',{text:text})):null; }
function openDrawer(d,from){
  lastFocus=from||document.activeElement;
  $('#dKind').textContent='Decision '+d.ref+(d.date?' · '+d.date:'')+' · '+d.area;
  $('#dTitle').textContent=d.title;
  const body=$('#dBody'); body.replaceChildren();
  if(d.data==='sample') body.append(h('div',{class:'note',text:'Sample entry. It shows how a log entry reads. Replace it with the project’s own.'}));
  [section('Decision',d.decision),section('Reason',d.reason),section('Alternative rejected',d.rejected),
   section('Fallback',d.fallback),section('Reverse when',d.reversal)].forEach(x=>x&&body.append(x));
  body.append(h('div',{class:'dsrc',text:d.source?'Source: '+d.source:'Source: sample data'}));
  veil.hidden=false; drawer.hidden=false;
  requestAnimationFrame(()=>{ veil.classList.add('open'); drawer.classList.add('open'); $('#dClose').focus(); });
}
function closeDrawer(){
  if(drawer.hidden) return;
  veil.classList.remove('open'); drawer.classList.remove('open');
  setTimeout(()=>{ veil.hidden=true; drawer.hidden=true; },190);
  if(lastFocus&&lastFocus.focus) lastFocus.focus();
}
veil.addEventListener('click',closeDrawer);
$('#dClose').addEventListener('click',closeDrawer);
document.addEventListener('keydown',e=>{
  if(e.key==='Escape') closeDrawer();
  if(e.key==='Tab' && !drawer.hidden){
    const f=[...drawer.querySelectorAll('button,[href],input,select,[tabindex]:not([tabindex="-1"])')].filter(n=>!n.disabled);
    if(!f.length) return;
    const first=f[0], last=f[f.length-1];
    if(e.shiftKey && document.activeElement===first){ e.preventDefault(); last.focus(); }
    else if(!e.shiftKey && document.activeElement===last){ e.preventDefault(); first.focus(); }
  }
});

/* ---------- In-page nav ---------- */
document.querySelectorAll('.nav a').forEach(a=>a.addEventListener('click',e=>{
  const t=document.getElementById(a.getAttribute('href').slice(1));
  if(t){ e.preventDefault(); t.scrollIntoView({behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'auto':'smooth',block:'start'}); }
}));

/* ---------- Boot ---------- */
renderStatus();
renderContrastChart();
wireChecker();
wireFilters();
renderAll();
})();
</script>

</body>
</html>
